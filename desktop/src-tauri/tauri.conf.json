{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUSICH",
  "version": "0.1.0",
  "identifier": "app.musich.desktop",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm --prefix ../web run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MUSICH",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPLOCALDATA/**", "$AUDIO/MUSICH/**", "$TEMP/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "rozev",
    "shortDescription": "MUSICH — своя музыка на ПК",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@device": [
        "./src/lib/device-api.d.ts"
      ],
      "@sync-view": [
        "./src/views/SyncStub.tsx"
      ]
    }
  },
  "include": [
    "src"
  ]
}

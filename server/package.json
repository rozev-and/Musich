{
  "name": "musich-server",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "MUSICH — сервер библиотеки музыки (контракт: ../docs/API.md)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=.env src/index.ts",
    "dev:watch": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@mtcute/web": "^0.32.8",
    "fastify": "^5.12.7",
    "multicast-dns": "^7.2.5",
    "music-metadata": "^12.3.2",
    "node-taglib-sharp": "^6.0.3",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.19.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

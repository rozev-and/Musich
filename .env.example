# Необязательно: всё настраивается в браузере (пароль, папки с музыкой, токены устройств).
# Скопировать в .env, только если нужно поменять что-то из этого. .env в git и в образ не попадает.

# Порт на хосте и адрес привязки (127.0.0.1 — если наружу торчит только через nginx)
MUSICH_PORT=2290
MUSICH_BIND=0.0.0.0

# Под каким uid:gid работает процесс в контейнере — владелец папок с музыкой на хосте
MUSICH_UID=1000
MUSICH_GID=1000

# Где на хосте лежат данные (SQLite, обложки) и папка с музыкой по умолчанию
DATA_PATH=./data
MUSIC_PATH=./music

TZ=Europe/Moscow

# Готовый образ из реестра вместо локальной сборки (тогда: docker compose pull && docker compose up -d)
# MUSICH_IMAGE=registry.example.lan/musich:latest
